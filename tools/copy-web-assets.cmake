# 用途：按用途同步前端资源；流程：CMake构建；传源码根/目标根与是否包含本地试炼；返回：复制结果，错误由CMake报告。
if(NOT DEFINED NZ_ASSET_SOURCE OR NOT DEFINED NZ_ASSET_DESTINATION)
    message(FATAL_ERROR "缺少前端资源同步目录")
endif()
file(GLOB_RECURSE NZ_ASSET_FILES LIST_DIRECTORIES FALSE "${NZ_ASSET_SOURCE}/*")
foreach(NZ_ASSET_FILE IN LISTS NZ_ASSET_FILES)
    file(RELATIVE_PATH NZ_ASSET_RELATIVE "${NZ_ASSET_SOURCE}" "${NZ_ASSET_FILE}")
    if(NOT NZ_INCLUDE_BATTLE_LAB AND NZ_ASSET_RELATIVE MATCHES "^battle-lab\\.(html|mjs|css)$")
        continue()
    endif()
    get_filename_component(NZ_ASSET_PARENT "${NZ_ASSET_RELATIVE}" DIRECTORY)
    file(MAKE_DIRECTORY "${NZ_ASSET_DESTINATION}/${NZ_ASSET_PARENT}")
    configure_file("${NZ_ASSET_FILE}" "${NZ_ASSET_DESTINATION}/${NZ_ASSET_RELATIVE}" COPYONLY)
endforeach()
